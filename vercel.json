{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/controller",
      "destination": "/api/controller"
    },
    {
      "source": "/security",
      "destination": "/api/security"
    },
    {
      "source": "/reports/:path*",
      "destination": "/api/reports/:path*"
    }
  ]
}